; -----------------------------------------------------------------------------
; xrVR - S.T.A.L.K.E.R. Shadow of Chernobyl (OGSR Engine) VR module
; Конфигурация. Положить в: <игра>/gamedata/configs/vr/vr_config.ltx
; -----------------------------------------------------------------------------

[vr]
; Включить VR при старте игры (если SteamVR запущен и шлем подключен)
vr_enabled        = on

; Автоматически включать VR при загрузке уровня
vr_auto_in_game   = on

; ---------------------------------------------------------------------------
; МАСШТАБ И РОСТ
; ---------------------------------------------------------------------------
; 1.0 = 1 игровой метр = 1 реальный метр (рекомендуется для ТЧ)
; 0.8 = мир кажется больше (мир "вырос", вы меньше)
; 1.2 = мир кажется меньше
vr_world_scale    = 1.0

; Рост игрока в метрах. Влияет на положение камеры относительно тела.
; Ставьте под свой рост (170-185 для взрослого)
vr_eye_height     = 1.78

; Масштаб межзрачкового расстояния (IPD)
; 1.0 = как настроено в SteamVR. Меняйте только если объекты "двоятся"
vr_ipd_scale      = 1.0

; ---------------------------------------------------------------------------
; РЕНДЕР
; ---------------------------------------------------------------------------
; Вертикальный FOV рендера (реальный пересчитывается из данных шлема,
; эта опция - ограничитель сверху). 90-110 - комфортно
vr_fov            = 100

; Ближняя и дальняя плоскости
vr_near           = 0.08
vr_far            = 1200

; MSAA: 1 (выкл), 2, 4 - сильно бьет по FPS в VR, начните с 1
vr_msaa           = 1

; Ограничение FPS. 0 = автоматически (частота шлема)
vr_max_fps        = 0

; Что показывать на мониторе: 0 - выкл, 1 - левый глаз, 2 - правый
vr_mirror         = 1

; ---------------------------------------------------------------------------
; VR-ЭКРАН ДЛЯ HUD / UI / МЕНЮ
; ---------------------------------------------------------------------------
; Показывать интерфейс в шлеме на "виртуальном экране"
vr_hud            = on

; Дистанция экрана от головы, метры (0.4-1.2 - комфортно)
vr_hud_distance   = 0.75

; Высота экрана, метры (0.6-1.2)
vr_hud_size       = 0.85

; ---------------------------------------------------------------------------
; УПРАВЛЕНИЕ И СТРЕЛЬБА
; ---------------------------------------------------------------------------
; Голова управляет взглядом отдельно от тела (мышь = поворот тела)
vr_head_look      = on

; Стрелять по направлению взгляда из ствола (иначе - как в оригинале,
; от бедра, с разбросом)
vr_weapon_aim     = on

; Предсказание позы, миллисекунды (0 = выключено, 10-20 - сглаживает)
vr_predict_ms     = 0
